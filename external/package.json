{
  "name": "@xaligo/xaligo-external",
  "version": "0.0.1",
  "description": "WebAssembly build of xaligo — convert .xal DSL to Excalidraw JSON from TypeScript/JavaScript",
  "keywords": [
    "xaligo",
    "excalidraw",
    "aws",
    "architecture-diagram",
    "wasm",
    "webassembly",
    "vscode-extension"
  ],
  "homepage": "https://github.com/xaligo/xaligo",
  "bugs": {
    "url": "https://github.com/xaligo/xaligo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xaligo/xaligo.git",
    "directory": "external"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build": "rimraf dist && tsc --emitDeclarationOnly && esbuild index.ts --bundle --format=esm --platform=node --target=es2020 --sourcemap --outfile=dist/index.js --external:@resvg/resvg-js && esbuild command.ts --bundle --format=esm --platform=node --target=es2020 --sourcemap --outfile=dist/cli.js --external:@resvg/resvg-js",
    "build:pptx-exporter-wasm": "npm run build && ${JAVY:-javy} build -J event-loop=y dist/cli.js -o wasm/xaligo.wasm",
    "test": "npm run build && node --test test/*.test.mjs",
    "dev": "esbuild index.ts command.ts --bundle --format=esm --platform=node --target=es2020 --sourcemap --outdir=dist --external:@resvg/resvg-js --watch",
    "clean": "rimraf dist"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "devDependencies": {
    "@tabler/icons": "^3.45.0",
    "@types/node": "^26.1.1",
    "esbuild": "0.28.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1"
  }
}
