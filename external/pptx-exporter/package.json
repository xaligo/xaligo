{
  "name": "@xaligo/xaligo-external",
  "version": "0.0.1",
  "description": "WASI PPTX exporter for resolved xaligo document plans",
  "keywords": [
    "xaligo",
    "aws",
    "architecture-diagram",
    "wasm",
    "webassembly",
    "vscode-extension"
  ],
  "homepage": "https://github.com/xaligo/xaligo",
  "bugs": {
    "url": "https://github.com/xaligo/xaligo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xaligo/xaligo.git",
    "directory": "external/pptx-exporter"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build": "node tool/build.mjs",
    "build:pptx-exporter-wasm": "npm run build && ${JAVY:-javy} build -J event-loop=y dist/cli.js -o wasm/xaligo.wasm",
    "test": "npm run build && node --test test/*.test.mjs",
    "dev": "node tool/build.mjs --watch",
    "clean": "rimraf dist"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "devDependencies": {
    "@tabler/icons": "^3.45.0",
    "@types/node": "^26.1.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1"
  }
}
