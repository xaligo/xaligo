<xaligo version="1">
  <data></data>
  <frames>
    <frame id="package" width="1360" height="720" class="pa-3">
      <uml id="package-dependencies" title="Clean Architecture Packages">
        <package-diagram direction="right">
          <package id="api" title="api">
            <responsibility>CLI and HTTP adapters</responsibility>
          </package>
          <package id="application" title="application">
            <responsibility>Use-case orchestration</responsibility>
          </package>
          <package id="domain" title="domain">
            <responsibility>Business rules</responsibility>
          </package>
          <package id="infrastructure" title="infrastructure">
            <responsibility>Database and messaging adapters</responsibility>
          </package>
          <package id="domain-common" title="domain-common">
            <responsibility>Shared value objects</responsibility>
          </package>
          <package id="ordering-domain" title="ordering-domain">
            <responsibility>Order aggregate</responsibility>
          </package>

          <package-import src="api" dst="application" title="imports" />
          <package-import src="application" dst="domain" title="imports" />
          <package-import src="infrastructure" dst="domain" title="implements ports from" />
          <package-merge src="ordering-domain" dst="domain-common" title="merges common types" />
          <dependency src="infrastructure" dst="application" title="configures" />
        </package-diagram>
      </uml>
    </frame>
  </frames>
</xaligo>
