<xaligo version="1">
  <data></data>
  <frames>
    <frame id="object" width="1280" height="700" class="pa-3">
      <uml id="runtime-snapshot" title="Confirmed Order Snapshot">
        <object-diagram direction="right">
          <object id="customer" title="customer: Customer">
            <slot>id = C-1042</slot>
            <slot>name = Alice</slot>
            <slot>tier = Gold</slot>
          </object>
          <object id="order" title="order42: Order">
            <slot>id = O-0042</slot>
            <slot>status = Confirmed</slot>
            <slot>total = 128.00 USD</slot>
          </object>
          <object id="line" title="line1: OrderLine">
            <slot>productId = P-900</slot>
            <slot>quantity = 2</slot>
            <slot>subtotal = 128.00 USD</slot>
          </object>
          <object id="payment" title="payment7: Payment">
            <slot>provider = ExamplePay</slot>
            <slot>state = Captured</slot>
            <slot>amount = 128.00 USD</slot>
          </object>
          <object id="gateway" title="gateway: PaymentGateway">
            <slot>region = ap-northeast-1</slot>
          </object>

          <link src="customer" dst="order" title="placed" />
          <link src="order" dst="line" title="contains" />
          <link src="order" dst="payment" title="paid by" />
          <dependency src="payment" dst="gateway" title="captured through" />
        </object-diagram>
      </uml>
    </frame>
  </frames>
</xaligo>
