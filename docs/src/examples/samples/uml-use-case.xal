<xaligo version="1">
  <data></data>
  <frames>
    <frame id="use-case" title="Ordering Use Cases" version="2026.07" width="1440" height="760" class="pa-3" margin-top="48">
      <metadata align="right" width="156" key-width="56" font-size="12" />
      <uml id="ordering-use-cases">
        <use-case-diagram direction="right">
          <actor id="customer" title="Customer">
            <responsibility>Place and track orders</responsibility>
          </actor>
          <actor id="member" title="Member">
            <responsibility>Use loyalty benefits</responsibility>
          </actor>
          <actor id="payment-provider" title="Payment Provider" />
          <system-boundary id="ordering-system" title="Ordering System" />
          <use-case id="place-order" owner="ordering-system" title="Place order">
            <responsibility>Create a confirmed order</responsibility>
          </use-case>
          <use-case id="pay" owner="ordering-system" title="Authorize payment">
            <constraint>Payment method is valid</constraint>
          </use-case>
          <use-case id="apply-discount" owner="ordering-system" title="Apply loyalty discount">
            <constraint>Customer is an active member</constraint>
          </use-case>
          <use-case id="track-order" owner="ordering-system" title="Track order" />

          <generalization src="member" dst="customer" title="specializes" />
          <association src="customer" dst="place-order" title="starts" />
          <association src="customer" dst="track-order" title="views" />
          <association src="payment-provider" dst="pay" title="authorizes" />
          <include src="place-order" dst="pay" title="include" />
          <extend src="apply-discount" dst="place-order" title="extend when eligible" />
        </use-case-diagram>
      </uml>
    </frame>
  </frames>
</xaligo>
