<xaligo version="1">
  <data></data>
  <frames>
    <frame id="timing" width="1560" height="820" class="pa-3">
      <uml id="request-timing" title="Checkout Request Timing">
        <timing-diagram>
          <lifeline id="client" title="Client" />
          <time-state id="client-idle" owner="client" from="0" to="20" title="Idle">
            <note>Waiting for user input</note>
          </time-state>
          <time-state id="client-wait" owner="client" from="20" to="120" title="Waiting">
            <constraint>response before 120 ms</constraint>
          </time-state>
          <lifeline id="server" title="Order Service" />
          <time-state id="server-idle" owner="server" from="0" to="20" title="Idle" />
          <time-state id="server-work" owner="server" from="20" to="100" title="Processing">
            <region>Validate 20..40 ms</region>
            <region>Persist 80..100 ms</region>
          </time-state>
          <lifeline id="database" title="Database" />
          <time-state id="database-query" owner="database" from="40" to="80" title="Querying">
            <note>transaction open</note>
          </time-state>

          <transition src="client-idle" dst="client-wait" title="submit at 20 ms" />
          <transition src="server-idle" dst="server-work" title="receive at 20 ms" />
          <occurrence src="client" dst="server" at="20" title="request" />
          <occurrence src="server" dst="database" at="40" title="query" />
          <occurrence src="database" dst="server" at="80" title="result" />
          <occurrence src="server" dst="client" at="100" title="response" />
          <duration src="server-work" dst="client-wait" from="20" to="100" title="80 ms response latency" />
        </timing-diagram>
      </uml>
    </frame>
  </frames>
</xaligo>
