      <metadata align="right" width="156" key-width="56" font-size="12" />
      <uml id="production-deployment">
        <deployment-diagram direction="right">
          <node id="browser" title="Client Device">
            <property>Chrome 128</property>
            <property>macOS / Windows</property>
          </node>
          <node id="edge" title="Edge Gateway">
            <property>HTTPS termination</property>
            <property>WAF enabled</property>
