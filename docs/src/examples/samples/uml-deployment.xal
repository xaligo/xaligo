          </artifact>
          <component id="migration" title="Schema Migrator">
            <interface title="Migration runner" />
          </component>

          <communication-path src="browser" dst="edge" title="HTTPS / 443" />
          <communication-path src="edge" dst="app-node" title="mTLS / 8443" />
          <communication-path src="app-node" dst="db-node" title="TLS / 5432" />
          <deployment src="web-bundle" dst="edge" title="served by" />
          <deployment src="service-image" dst="app-node" title="deployed to" />
          <deployment src="migration" dst="app-node" title="runs on" />
