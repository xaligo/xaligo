<xaligo version="1">
  <data></data>
  <frames>
    <frame id="component" title="Ordering Service Components" version="2026.07" width="1560" height="820" class="pa-3" margin-top="48">
      <metadata align="right" width="156" key-width="56" font-size="12" />
      <uml id="service-components">
        <component-diagram direction="right" grid="3">
          <component id="web" title="Web UI">
            <required-interface>Ordering API</required-interface>
          </component>
          <component id="orders" title="Order Service">
            <provided-interface>Ordering API</provided-interface>
            <required-interface>Order Store</required-interface>
            <responsibility>Ordering use cases</responsibility>
          </component>
          <component id="repository-adapter" title="PostgreSQL Adapter">
            <provided-interface>Order Store</provided-interface>
          </component>
          <artifact id="schema" title="order-schema.sql">
            <property>version = 12</property>
          </artifact>

          <association src="web" dst="orders" />
          <association src="orders" dst="repository-adapter" />
          <dependency src="repository-adapter" dst="schema" />
        </component-diagram>
      </uml>
    </frame>
  </frames>
</xaligo>
