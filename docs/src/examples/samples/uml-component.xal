<xaligo version="1">
  <data></data>
  <frames>
    <frame id="component" width="1560" height="820" class="pa-3">
      <uml id="service-components" title="Ordering Service Components">
        <component-diagram direction="right">
          <component id="web" title="Web UI">
            <required-interface>Ordering API</required-interface>
          </component>
          <port id="web-api" owner="web" title="orders: required" />
          <interface id="ordering-api" title="Ordering API">
            <operation>+ submitOrder(command)</operation>
            <operation>+ getOrder(id)</operation>
          </interface>
          <component id="orders" title="Order Service">
            <provided-interface>Ordering API</provided-interface>
            <required-interface>Order Store</required-interface>
            <responsibility>Ordering use cases</responsibility>
          </component>
          <port id="orders-http" owner="orders" title="http: provided" />
          <port id="orders-store" owner="orders" title="store: required" />
          <interface id="store-api" title="Order Store">
            <operation>+ save(order)</operation>
            <operation>+ find(id)</operation>
          </interface>
          <component id="repository-adapter" title="PostgreSQL Adapter">
            <provided-interface>Order Store</provided-interface>
          </component>
          <port id="adapter-store" owner="repository-adapter" title="store: provided" />
          <artifact id="schema" title="order-schema.sql">
            <property>version = 12</property>
          </artifact>

          <assembly src="web-api" dst="orders-http" title="HTTP assembly" />
          <realization src="orders" dst="ordering-api" title="provides" />
          <assembly src="orders-store" dst="adapter-store" title="persistence assembly" />
          <realization src="repository-adapter" dst="store-api" title="provides" />
          <dependency src="repository-adapter" dst="schema" title="uses schema" />
        </component-diagram>
      </uml>
    </frame>
  </frames>
</xaligo>
