<xaligo version="1">
  <data></data>
  <frames>
    <frame id="composite" title="Checkout Internal Structure" version="2026.07" width="1560" height="820" class="pa-3" margin-top="48">
      <metadata align="right" width="156" key-width="56" font-size="12" />
      <uml id="checkout-internals">
        <composite-structure-diagram direction="right">
          <structure id="checkout" title="Checkout">
            <property>session: CheckoutSession</property>
            <property>requires Payment Authorization</property>
          </structure>
          <collaboration id="checkout-rules" title="Checkout Collaboration" />
          <part id="cart" owner="checkout" title="cart: Cart">
            <responsibility>Own line items</responsibility>
          </part>
          <part id="pricing" owner="checkout" title="pricing: Pricing">
            <responsibility>Calculate totals and tax</responsibility>
          </part>
          <part id="payment" owner="checkout" title="payment: PaymentAdapter">
            <responsibility>Authorize a payment</responsibility>
          </part>
          <port id="checkout-in" owner="checkout" title="checkout: required" />
          <port id="cart-in" owner="cart" title="command: provided" />
          <port id="cart-pricing" owner="cart" title="pricing: required" />
          <port id="pricing-in" owner="pricing" title="pricing: provided" />
          <port id="pricing-payment" owner="pricing" title="payment: required" />
          <port id="payment-in" owner="payment" title="payment: provided" />

          <delegation src="checkout-in" dst="cart-in" title="delegates command" />
          <connector src="cart-pricing" dst="pricing-in" title="price cart" />
          <assembly src="pricing-payment" dst="payment-in" title="authorize payment" />
          <dependency src="checkout" dst="checkout-rules" title="uses collaboration" />
        </composite-structure-diagram>
      </uml>
    </frame>
  </frames>
</xaligo>
