<xaligo version="1">
  <data></data>
  <frames>
    <frame id="communication" title="Checkout Communication" version="2026.07" width="1280" height="720" class="pa-3" margin-top="48">
      <metadata align="right" width="156" key-width="56" font-size="12" />
      <uml id="checkout-communication">
        <communication-diagram direction="right">
          <object id="ui" title="ui: CheckoutPage">
            <slot>cartId = C-1042</slot>
          </object>
          <object id="controller" title="controller: CheckoutController" />
          <object id="orders" title="orders: OrderService" />
          <object id="payments" title="payments: PaymentGateway" />

          <link src="ui" dst="controller" title="browser channel" />
          <link src="controller" dst="orders" title="in-process call" />
          <link src="orders" dst="payments" title="payment channel" />

          <message src="ui" dst="controller" order="1" title="submit(cart)" />
          <message src="controller" dst="orders" order="1.1" title="placeOrder(cart)" />
          <message src="orders" dst="payments" order="1.1.1" title="authorize(total)" />
          <message src="payments" dst="orders" order="1.1.2" title="authorized" />
          <message src="orders" dst="controller" order="1.2" title="confirmedOrder" />
          <message src="controller" dst="ui" order="2" title="showConfirmation()" />
        </communication-diagram>
      </uml>
    </frame>
  </frames>
</xaligo>
