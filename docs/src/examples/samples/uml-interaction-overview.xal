<xaligo version="1">
  <data></data>
  <frames>
    <frame id="interaction-overview" title="Checkout Interaction Overview" version="2026.07" width="1800" height="900" class="pa-3" margin-top="48">
      <metadata align="right" width="156" key-width="56" font-size="12" />
      <uml id="checkout-overview">
        <interaction-overview-diagram direction="right">
          <initial id="start" title="Start" />
          <interaction id="browse" notation="sd" title="Browse products">
            <note>Customer adds products to the cart</note>
          </interaction>
          <decision id="cart" title="Cart has items?" />
          <interaction id="abandon" notation="ref" title="Abandon cart" />
          <fork id="checkout-fork" title="Fork" />
          <interaction id="reserve" notation="ref" title="Reserve inventory" />
          <interaction id="authorize" notation="ref" title="Authorize payment" />
          <join id="checkout-join" title="Join" />
          <decision id="authorized" title="Payment authorized?" />
          <interaction id="confirm" notation="ref" title="Confirm order" />
          <interaction id="compensate" notation="ref" title="Release inventory" />
          <merge id="completion-merge" title="Merge" />
          <interaction id="finalize" notation="ref" title="Finish checkout" />
          <final id="done" title="Done" />

          <control-flow src="start" dst="browse" />
          <control-flow src="browse" dst="cart" />
          <control-flow src="cart" dst="abandon" guard="no" />
          <control-flow src="cart" dst="checkout-fork" guard="yes" />
          <control-flow src="checkout-fork" dst="reserve" />
          <control-flow src="checkout-fork" dst="authorize" />
          <control-flow src="reserve" dst="checkout-join" />
          <control-flow src="authorize" dst="checkout-join" />
          <control-flow src="checkout-join" dst="authorized" />
          <control-flow src="authorized" dst="confirm" guard="yes" />
          <control-flow src="authorized" dst="compensate" guard="no" />
          <control-flow src="abandon" dst="completion-merge" />
          <control-flow src="confirm" dst="completion-merge" />
          <control-flow src="compensate" dst="completion-merge" />
          <control-flow src="completion-merge" dst="finalize" />
          <control-flow src="finalize" dst="done" />
        </interaction-overview-diagram>
      </uml>
    </frame>
  </frames>
</xaligo>
