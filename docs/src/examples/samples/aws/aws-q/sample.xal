        <rectangle id="overview" width="920" height="180" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Design review / 設計レビュー&#10;Research: service-context&#10;AWS::QBusiness::Application&#10;Configuration context; icon itself may represent a feature." />
      </row>
      <row height="242" gap="24"><rectangle id="part-1" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Service configuration context&#10;Application&#10;Attachments Config: object&#10;Auto Subscription Config: object&#10;Client Ids For OIDC: list&#10;Encryption Config: object&#10;Iam Identity Provider Arn: String" />
        <rectangle id="part-2" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Nested configuration&#10;Attachments Config -&gt; object&#10;Attachments Control Mode*: String&#10;Auto Subscription Config -&gt; object&#10;Auto Subscribe*: String&#10;Default Subscription Type: String" />
        <rectangle id="part-3" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Additional parameters&#10;Identity Center Instance Arn: String&#10;Identity Type: String&#10;Personalization Config: object&#10;QApps Config: object&#10;Quick Sight Config: object&#10;Role Arn: String&#10;Complete field list in README" /></row>
      <row height="242" gap="24"><rectangle id="part-4" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Referenced resource types&#10;No peer type selected from ID fields&#10;Full service type inventory in README" />
        <rectangle id="part-5" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Operations / lifecycle&#10;CreateApplication&#10;GetApplication&#10;ListApplications&#10;UpdateApplication&#10;DeleteApplication&#10;Input / output schemas: linked API sheet" />
        <rectangle id="part-6" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Icon meaning / interpretation&#10;Amazon Q&#10;Service-level schema shown as context&#10;Do not infer API fields from icon artwork&#10;Solid enclosure = authored membership&#10;Type references are not traffic paths" /></row>
      <rectangle id="design-legend" width="1284" height="150" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="DESIGN CONTRACT / 図の読み方&#10;* = required in the source schema, not a required XAL attribute. Values are not deployed to AWS.&#10;Configuration / API cards are references, not automatically nested resources or network traffic.&#10;Availability and region support must be checked before deployment. Research source/version and full parameter tables: README." />
