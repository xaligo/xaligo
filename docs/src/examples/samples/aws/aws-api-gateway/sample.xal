<frames>
  <frame id="sample" title="aws-api-gateway" width="1500" height="1160">
    <col width="1360" height="1000" margin="32" gap="24">
      <row height="230" gap="32"><aws-api-gateway id="component" label="Amazon API Gateway" label-width="340" />
        <rectangle id="overview" width="920" height="180" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Design review / 設計レビュー&#10;Research: service-context&#10;AWS::ApiGateway::RestApi&#10;Configuration context; icon itself may represent a feature." />
      </row>
      <row height="242" gap="24"><rectangle id="part-1" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Service configuration context&#10;RestApi&#10;Api Key Source Type: String&#10;Binary Media Types: list&#10;Body: Json&#10;Body S3 Location: object&#10;Clone From: String" />
        <rectangle id="part-2" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Nested configuration&#10;Body S3 Location -&gt; object&#10;Bucket: String&#10;ETag: String&#10;Endpoint Config -&gt; object&#10;Ip Address Type: String&#10;Types: list" />
        <rectangle id="part-3" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Additional parameters&#10;Disable Execute Api Endpoint: Boolean&#10;Endpoint Access Mode: String&#10;Endpoint Config: object&#10;Fail On Warnings: Boolean&#10;Minimum Compression Size: Integer&#10;Mode: String&#10;Complete field list in README" /></row>
      <row height="242" gap="24"><rectangle id="part-4" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Referenced resource types&#10;No peer type selected from ID fields&#10;Full service type inventory in README" />
        <rectangle id="part-5" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Operations / lifecycle&#10;CreateRestApi&#10;PutRestApi&#10;GetRestApi&#10;GetRestApis&#10;UpdateRestApi&#10;Input / output schemas: linked API sheet" />
        <rectangle id="part-6" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Icon meaning / interpretation&#10;Amazon API Gateway&#10;Service-level schema shown as context&#10;Do not infer API fields from icon artwork&#10;Solid enclosure = authored membership&#10;Type references are not traffic paths" /></row>
      <rectangle id="design-legend" width="1284" height="150" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="DESIGN CONTRACT / 図の読み方&#10;* = required in the source schema, not a required XAL attribute. Values are not deployed to AWS.&#10;Configuration / API cards are references, not automatically nested resources or network traffic.&#10;Availability and region support must be checked before deployment. Research source/version and full parameter tables: README." />
