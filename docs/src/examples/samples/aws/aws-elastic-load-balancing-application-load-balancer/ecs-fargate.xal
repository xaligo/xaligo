<!-- Logical service membership; registered targets use AWS ip/instance/lambda types. -->
<xaligo version="2">
  <frames>
<frame id="ecs-fargate" title="ALB / ecs-fargate" width="547" height="575">
      <aws-elastic-load-balancing-application-load-balancer id="alb" domain="api.example.test" detail-level="detailed" margin="24">
        <aws-listener id="https" protocol="HTTPS" port="443" target-group="orders" />
        <aws-target-group id="orders" name="orders" target-type="ip" protocol="HTTP" port="8080">
          <aws-option id="health" name="health-check-path" value="/health" />
          <aws-target-service id="ecs-orders" service="ecs" name="注文API">
            <aws-option id="cluster" name="cluster" value="production" />
            <aws-option id="launch" name="launch-type" value="fargate" />
            <aws-option id="network" name="network-mode" value="awsvpc" />
            <aws-option id="container" name="container-name" value="orders-api" />
            <aws-option id="container-port" name="container-port" value="8080" />
            <aws-registered-target id="task-a" name="10.20.1.20" port="8080" zone="ap-northeast-1a" />
            <aws-registered-target id="task-c" name="10.20.3.20" port="8080" zone="ap-northeast-1c" />
          </aws-target-service>
        </aws-target-group>
      </aws-elastic-load-balancing-application-load-balancer>
    </frame>
  </frames>
</xaligo>
