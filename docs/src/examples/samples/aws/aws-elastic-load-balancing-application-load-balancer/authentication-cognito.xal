<!-- Editable native ALB example; AWS setting references are not credentials or deployment configuration. -->
<xaligo version="2">
  <frames>
<frame id="authentication-cognito" title="ALB / authentication-cognito" width="507" height="783">
      <aws-elastic-load-balancing-application-load-balancer id="alb" domain="api.example.test" detail-level="detailed" margin="24">
        <aws-listener id="listener-74" protocol="HTTPS" port="443" certificate="server-cert">
          <aws-listener-rule id="rule-73" priority="10">
            <aws-rule-condition id="condition-69" field="path-pattern">
              <aws-rule-match id="match-70" value="/secure/*" />
            </aws-rule-condition>
            <aws-rule-action id="auth-71" type="authenticate-cognito" order="1">
              <aws-option id="opt-61" name="client-id" value="client-id" />
              <aws-option id="opt-62" name="on-unauthenticated-request" value="authenticate" />
              <aws-option id="opt-63" name="scope" value="openid email" />
              <aws-option id="opt-64" name="session-cookie" value="ALBAuthSession" />
              <aws-option id="opt-65" name="session-timeout" value="3600" />
              <aws-option id="opt-66" name="auth-parameter" value="login" key="prompt" />
              <aws-option id="opt-67" name="user-pool" value="user-pool-arn" />
              <aws-option id="opt-68" name="user-pool-domain" value="login.example.test" />
            </aws-rule-action>
            <aws-rule-action id="forward-72" type="forward" order="2" target-group="app" />
          </aws-listener-rule>
        </aws-listener>
      </aws-elastic-load-balancing-application-load-balancer>
    </frame>
  </frames>
</xaligo>
