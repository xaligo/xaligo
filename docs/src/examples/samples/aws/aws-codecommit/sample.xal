<frames>
  <frame id="sample" title="aws-codecommit" width="1500" height="1160">
    <col width="1360" height="1000" margin="32" gap="24">
      <row height="230" gap="32"><aws-codecommit id="component" label="AWS CodeCommit" label-width="340" />
        <rectangle id="overview" width="920" height="180" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Design review / 設計レビュー&#10;Research: service-context&#10;AWS::CodeCommit::Repository&#10;Configuration context; icon itself may represent a feature." />
      </row>
      <row height="242" gap="24"><rectangle id="part-1" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Service configuration context&#10;Repository&#10;Code: object&#10;Kms Key Id: String&#10;Triggers: list&#10;Repository Name*: String&#10;Repository Description: String" />
        <rectangle id="part-2" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Nested configuration&#10;Code -&gt; object&#10;S3*: object&#10;Branch Name: String&#10;Triggers -&gt; object&#10;Dest Arn*: String&#10;Events*: list" />
        <rectangle id="part-3" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Additional parameters&#10;Tags: list" /></row>
      <row height="242" gap="24"><rectangle id="part-4" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Referenced resource types&#10;No peer type selected from ID fields&#10;Full service type inventory in README" />
        <rectangle id="part-5" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Operations / lifecycle&#10;CreateRepository&#10;GetRepository&#10;DeleteRepository&#10;PutRepositoryTriggers&#10;GetRepositoryTriggers&#10;Input / output schemas: linked API sheet" />
        <rectangle id="part-6" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Icon meaning / interpretation&#10;AWS CodeCommit&#10;Service-level schema shown as context&#10;Do not infer API fields from icon artwork&#10;Solid enclosure = authored membership&#10;Type references are not traffic paths" /></row>
      <rectangle id="design-legend" width="1284" height="150" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="DESIGN CONTRACT / 図の読み方&#10;* = required in the source schema, not a required XAL attribute. Values are not deployed to AWS.&#10;Configuration / API cards are references, not automatically nested resources or network traffic.&#10;Availability and region support must be checked before deployment. Research source/version and full parameter tables: README." />
