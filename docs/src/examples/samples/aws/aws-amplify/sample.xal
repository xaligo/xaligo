      <row height="242" gap="24"><rectangle id="part-1" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Service configuration context&#10;App&#10;Access Token: String&#10;Auto Branch Creation Config: object&#10;Basic Auth Config: object&#10;Build Spec: String&#10;Cache Config: object" />
        <rectangle id="part-2" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Nested configuration&#10;Auto Branch Creation Config -&gt; object&#10;Auto Branch Creation Patterns: list&#10;Basic Auth Config: object&#10;Basic Auth Config -&gt; object&#10;Enable Basic Auth: Boolean&#10;Password: String" />
        <rectangle id="part-3" width="412" height="242" font-size="16" fill="#f8fafc" stroke="#cbd5e1" title="Additional parameters&#10;Compute Role Arn: String&#10;Custom Headers: String&#10;Custom Rules: list&#10;Enable Branch Auto Deletion: Boolean&#10;Environment Variables: list&#10;IAMService Role: String&#10;Complete field list in README" /></row>
